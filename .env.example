# make init создаёт .env с отдельными случайными локальными паролями.
COMPOSE_PROJECT_NAME=flink-cdc-lakehouse-lab
POSTGRES_ADMIN_PASSWORD=local_admin_change_me
APP_PASSWORD=local_app_change_me
CDC_PASSWORD=local_cdc_change_me
CATALOG_PASSWORD=local_catalog_change_me
MINIO_ROOT_USER=lab_admin
MINIO_ROOT_PASSWORD=local_minio_root_change_me
S3_ACCESS_KEY=lab_pipeline
S3_SECRET_KEY=local_pipeline_change_me
PG_PORT=55432
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
CATALOG_PORT=19002
FLINK_PORT=18081
TRINO_PORT=18080
PARALLELISM=1
TASK_SLOTS=4
CHECKPOINT_INTERVAL_MS=10000
CHECKPOINT_TIMEOUT_MS=120000
CHECKPOINT_MIN_PAUSE_MS=1000
RESTART_ATTEMPTS=10
SEED=42
RATE=20
DURATION=120
BATCH_SIZE=20

# Superset credentials are generated by make init / make superset-up.
SUPERSET_PORT=18088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=local_superset_admin_change_me
SUPERSET_DATABASE_PASSWORD=local_superset_database_change_me
SUPERSET_BI_PASSWORD=local_superset_bi_change_me
SUPERSET_SECRET_KEY=local_superset_secret_change_me
