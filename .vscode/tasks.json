{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Java: test",
      "type": "process",
      "command": "${workspaceFolder}/mvnw",
      "args": [
        "-B",
        "-ntp",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/Users/dleventsov/Library/Java/JavaVirtualMachines/corretto-17.0.12/Contents/Home"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$javac"
      ]
    },
